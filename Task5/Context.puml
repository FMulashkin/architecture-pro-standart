@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' =============== АКТОРЫ ===============
Person(клиент, "Зарегистрированный клиент", "Подаёт заявку на кредит через интернет-банк")
Person(сотрудник_бэк_офиса, "Сотрудник бэк-офиса", "Обрабатывает сложные заявки")

' =============== СИСТЕМЫ ===============
System(интернет_банк, "Интернет-банк", "Инициация заявки, подтверждение через SMS")
System(система_скоринга, "Система скоринга", "Автоматическая проверка клиента")
System(кредитный_сервис, "Кредитный процессинговый сервис", "Оркестрация: проверка, маршрутизация, интеграция")
System(абс, "АБС", "Открытие кредитного счёта, ведение договора")
System(sms_шлюз, "SMS-шлюз", "Отправка кодов и уведомлений")
System(crm_бэк_офиса, "CRM бэк-офиса", "Работа с заявками, документами")

' =============== СВЯЗИ ===============
Rel(клиент, интернет_банк, "Подаёт заявку", "HTTPS")
Rel(интернет_банк, кредитный_сервис, "Передаёт заявку", "REST/HTTPS")
Rel(кредитный_сервис, система_скоринга, "Запрашивает решение", "REST/HTTPS")
Rel(кредитный_сервис, crm_бэк_офиса, "Направляет на ручную обработку", "REST/HTTPS")
Rel(кредитный_сервис, абс, "Открывает счёт", "REST/HTTPS")
Rel(кредитный_сервис, sms_шлюз, "Отправляет результат", "HTTPS")
Rel(сотрудник_бэк_офиса, crm_бэк_офиса, "Работает с заявкой", "Веб-интерфейс")

' Подпись
Footer C4 Level 1: Контекст онлайн-кредита | Горизонт 12 месяцев | 2026
@enduml