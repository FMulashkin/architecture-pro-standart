@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' =============== АКТОРЫ ===============
Person(сотрудник_бэк_офиса, "Сотрудник бэк-офиса", "Редактирует ставки")
Person(оператор_внутренний, "Оператор внутреннего кол-центра", "Консультирует клиентов")
Person(оператор_партнер, "Оператор партнёрского кол-центра", "Работает по файлу")

' =============== ГРАНИЦЫ СИСТЕМ ===============
System_Boundary(ставка_граница, "Система управления ставками") {
    Container(ставки_ui, "Web UI", "React", "Интерфейс редактирования ставок")
    Container(ставки_api, "REST API", "Java/Spring Boot", "Обслуживание запросов от систем")
    Container(ставки_export, "Служба экспорта", "Java/Python", "Генерирует CSV и отправляет на SFTP")
    ContainerDb(ставки_db, "БД ставок", "MS SQL / Oracle", "Хранение ставок, версий, истории изменений")
}

System(внутренний_колцентр, "Система внутреннего кол-центра", "CRM + телефония")
System(sftp_server, "SFTP-сервер", "Secure File Transfer")
System(внешняя_система_партнера, "Внешняя система партнёра", "Файловая интеграция")

' =============== СВЯЗИ ===============
Rel(сотрудник_бэк_офиса, ставки_ui, "Редактирует ставки", "HTTPS")
Rel(ставки_ui, ставки_api, "Вызов API", "HTTP")
Rel(ставки_api, ставки_db, "Чтение/запись данных", "JDBC/ODBC")

Rel(ставки_api, внутренний_колцентр, "GET /rates (актуальные)", "HTTPS")
Rel(ставки_export, sftp_server, "PUT rates.csv", "SFTP")
Rel(sftp_server, внешняя_система_партнера, "GET rates.csv", "SFTP")

Rel(оператор_внутренний, внутренний_колцентр, "Работает в CRM")
Rel(оператор_партнер, внешняя_система_партнера, "Читает данные из системы")

' Подпись
Footer C4 Level 2: Архитектура контейнеров — Распределение ставок | MVP | 2025
@enduml