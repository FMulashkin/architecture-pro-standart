@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' =============== АКТОРЫ ===============
Person(сотрудник_бэк_офиса, "Сотрудник бэк-офиса", "Редактирует ставки по депозитам")
Person(оператор_внутренний, "Оператор внутреннего кол-центра", "Консультирует клиентов по ставкам")
Person(оператор_партнер, "Оператор партнёрского кол-центра", "Работает с файлом ставок")

' =============== СИСТЕМЫ ===============
System(система_управления_ставками, "Система управления ставками", "Центральное хранение и редактирование ставок")
System(внутренний_колцентр, "Система внутреннего кол-центра", "CRM + интерфейс оператора")
System(sftp_server, "SFTP-сервер", "Безопасная передача файлов")
System(внешняя_система_партнера, "Внешняя система партнёра", "Получает файлы с актуальными ставками")

' =============== СВЯЗИ ===============
Rel(сотрудник_бэк_офиса, система_управления_ставками, "Редактирует ставки", "HTTPS")
Rel(система_управления_ставками, внутренний_колцентр, "Предоставляет ставки", "REST API, HTTPS")
Rel(система_управления_ставками, sftp_server, "Экспорт файла ставок", "SFTP")
Rel(sftp_server, внешняя_система_партнера, "Файл выгружается", "SFTP pull")
Rel(оператор_внутренний, внутренний_колцентр, "Просматривает ставки", "Внутренний интерфейс")
Rel(оператор_партнер, внешняя_система_партнера, "Использует данные из системы", "Работа с интерфейсом")

' Подпись
Footer C4 Level 1: Контекст распределения ставок | Банк «Стандарт» | 2025
@enduml