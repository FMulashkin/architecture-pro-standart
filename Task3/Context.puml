@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' =============== АКТОРЫ ===============
Person(клиент_новый, "Новый клиент", "Посетитель сайта банка")
Person(клиент_зарегистрированный, "Зарегистрированный клиент", "Пользователь интернет-банка")
Person(менеджер_колцентра, "Менеджер кол-центра", "Обрабатывает заявки с сайта")
Person(сотрудник_бэк_офиса, "Сотрудник бэк-офиса", "Подтверждает заявки и управляет ставками")

' =============== СИСТЕМЫ ===============
System(сайт, "Сайт банка", "Просмотр депозитов и подача заявок новыми клиентами")
System(интернет_банк, "Интернет-банк", "Онлайн-подача заявок зарегистрированными клиентами")
System(абс, "АБС", "Ядро банка: открытие депозитов, управление счетами")
System(система_управления_ставками, "Система управления ставками", "Централизованное хранение и редактирование ставок по депозитам")
System(система_кол_центра, "Система кол-центра", "Работа с заявками от новых клиентов")
System(sms_шлюз, "SMS-шлюз", "Отправка одноразовых кодов и уведомлений")

' =============== СВЯЗИ ===============
Rel(клиент_новый, сайт, "Просматривает депозиты, подаёт заявку", "HTTPS")
Rel(сайт, система_управления_ставками, "Запрашивает актуальные ставки", "REST/HTTPS")
Rel(сайт, система_кол_центра, "Передаёт заявку", "REST/HTTPS")
Rel(система_кол_центра, менеджер_колцентра, "Показывает заявку", "Внутренний интерфейс")

Rel(клиент_зарегистрированный, интернет_банк, "Работает с депозитами", "HTTPS")
Rel(интернет_банк, система_управления_ставками, "Запрашивает персональные и общие ставки", "REST/HTTPS")
Rel(интернет_банк, sms_шлюз, "Запрашивает SMS-код", "HTTPS")
Rel(интернет_банк, абс, "Подаёт заявку на депозит", "Через промежуточный сервис (асинхронно)")

Rel(сотрудник_бэк_офиса, система_управления_ставками, "Редактирует ставки", "Веб-интерфейс")
Rel(сотрудник_бэк_офиса, абс, "Подтверждает заявку, открывает депозит", "API")

' Подпись
Footer Концептуальная архитектура MVP: Открытие депозитов | © Банк, 2026
@enduml